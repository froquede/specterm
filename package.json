{
  "name": "specterm",
  "private": true,
  "version": "0.11.1",
  "description": "A fast, GPU-accelerated terminal emulator with built-in markdown preview.",
  "author": "Roque Francisco <roquefsd@gmail.com>",
  "contributors": [
    "Lucas Casanova (https://github.com/cas0la)",
    "Henrique Begrow (https://github.com/hbegrow)"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
    "build": "vite build",
    "start:electron": "npm run build && electron .",
    "build:electron": "npm run build && electron-builder --linux AppImage deb --publish never",
    "build:electron:win": "npm run build && electron-builder --win nsis --publish never",
    "build:electron:mac": "npm run build && electron-builder --mac --publish never",
    "install:mac": "npm run build:electron:mac && node scripts/install-mac.cjs",
    "install:mac:only": "node scripts/install-mac.cjs",
    "preview": "vite preview",
    "test:e2e": "vite build && node test/e2e.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.4.0",
    "nanoid": "^5.0.0",
    "node-pty": "^1.0.0",
    "solid-js": "^1.9.0"
  },
  "build": {
    "appId": "com.specterm.terminal",
    "productName": "Specterm",
    "directories": {
      "output": "build-output"
    },
    "afterSign": "scripts/adhoc-sign.cjs",
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "TerminalEmulator"
    },
    "deb": {
      "afterInstall": "build/linux/after-install.tpl"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.1.2",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "wait-on": "^8.0.0"
  }
}
